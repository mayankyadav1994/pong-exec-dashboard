{
  "_comment": "Lane rules for the Roadmap pages (roadmap.py). Version names are matched against `match` regexes (first match wins, in the order listed). Dev-owned config; PMO dates live in config/roadmap-pmo.json.",
  "window": { "months_back": 1, "months_forward": 8, "from_year_start": true,
              "_comment": "from_year_start: data starts 1 Jan of this year (Jan-Mar: last year) so you can scroll back; the page still opens on Today." },
  "scope": { "container_age_months": 12,
             "_comment": "A feature epic is listed on a release card if the epic itself carries that fix version, or it has new stories there and was created within container_age_months. Older untagged epics are long-running containers (Game Menu / Server / System / Website ...) and are only counted." },
  "planning": { "data": "roadmap-planning.json",
                "_comment": "Planning sub-page per space (roadmap-<space>-planning.html): PMO initiatives imported from the SharePoint sheet named in the data file, each mapped to Jira epics. Not mixed into the release roadmap." },
  "extra_nav": [ { "id": "people", "title": "People", "file": "people.html",
                   "_comment": "Built by people.py (who works on what, week by week)." } ],
  "bucket_re":"(Backlog|^New Games|^New Features|Features$|R&D|Dev Test|Game Config|Website|Training|Cleanup|Show Prep)",
  "skip_root_re": "^(Release\\b|Release -|QA Testing|QA testing)|^(CS|V2|PFH2?|ELG)\\b[^:]*\\d+\\.\\d+\\s*$",
  "spaces": {
    "igaming": {
      "title": "iGaming",
      "pipeline": "ig",
      "file": "roadmap-igaming.html",
      "projects": ["IG", "CSS"],
      "history": ["release-history-ig.json", "release-history-igf.json"],
      "game_re": "^(Gen2\\s*-?\\s*)?Game\\s*(:|\\s-\\s)",
      "_markets": "Game markets = the pfh / elg / hp groups. 'New Games - iGaming' holds ELG-bound games, 'New Games - PFH' PFH-bound ones.",
      "game_projects": ["IG"],
      "non_markets": ["kiosk"],
      "market_from_epic": true,
      "_market_from_epic": "A game is in ELG/PFH only if its own epic carries that release version; bugs filed under old or other games never make them a launch.",
      "groups": [
        { "id": "pfh", "label": "PFH",
          "match": "^(PFH(?!2? Services)|New Games - PFH|New Features - iGaming)",
          "projects": ["IG"],
          "lanes": [
            { "id": "releases",   "label": "Releases · Games & Features", "filter": "all", "color": "blue" },
            { "id": "publishing", "label": "Game Publishing", "kind": "publishing", "color": "green" }
          ] },
        { "id": "elg", "label": "ELG", "golive_from_release": true,
          "match": "^(ELG|New Games - iGaming)",
          "projects": ["IG"],
          "lanes": [
            { "id": "releases",   "label": "Releases · Games & Features", "filter": "all", "color": "blue" },
            { "id": "publishing", "label": "Game Publishing", "kind": "publishing", "color": "green" }
          ] },
        { "id": "hp", "label": "Horse Play", "hide_if_empty": true,
          "match": "^Horse Play",
          "projects": ["IG"],
          "lanes": [
            { "id": "all", "label": "Releases", "filter": "all", "color": "rose" }
          ] },
        { "id": "kiosk", "label": "Kiosk",
          "match": "^PFH2? Services",
          "projects": ["IG", "CSS"],
          "lanes": [
            { "id": "all", "label": "Kiosk & Services", "filter": "all", "color": "amber" }
          ] }
      ]
    },
    "v2": {
      "title": "V2",
      "pipeline": "v2",
      "file": "roadmap-v2.html",
      "projects": ["V2"],
      "history": ["release-history-v2.json"],
      "game_re": "^Game\\s*:",
      "_markets": "Game markets = the P2P / PT / SW / C2 / HHR lanes. Games with a due date but no market version go to 'No market assigned'.",
      "game_projects": ["V2"],
      "non_markets": ["newgames", "other"],
      "unassigned_games": { "group": "v2", "lane": "newgames" },
      "groups": [
        { "id": "v2", "label": "", "projects": ["V2"],
          "lanes": [
            { "id": "p2p",   "label": "P2P",   "match": "^V2 P2P", "filter": "all", "color": "blue" },
            { "id": "pt",    "label": "PT",    "match": "^V2 PT",  "filter": "all", "color": "violet" },
            { "id": "sw",    "label": "SW",    "match": "^V2 SW",  "filter": "all", "color": "green" },
            { "id": "c2",    "label": "C2",    "match": "^V2 C2",  "filter": "all", "color": "amber" },
            { "id": "hhr",   "label": "HHR",   "match": "^V2 HHR", "filter": "all", "color": "rose" },
            { "id": "newgames", "label": "Games · No market assigned", "match": "^New Games", "filter": "all", "color": "blue" },
            { "id": "other", "label": "Other", "match": ".",       "filter": "all", "color": "grey" }
          ] }
      ]
    },
    "css": {
      "title": "Cloud Services",
      "file": "roadmap-css.html",
      "projects": ["CSS"],
      "history": [],
      "game_re": "^\\b$",
      "groups": [
        { "id": "css", "label": "", "projects": ["CSS"],
          "lanes": [
            { "id": "vgtc",  "label": "VGTC",          "match": "VGTC",                 "filter": "all", "color": "blue" },
            { "id": "crm",   "label": "CRM",           "match": "CRM",                  "filter": "all", "color": "violet" },
            { "id": "th",    "label": "Task Handler",  "match": "\\bTH\\b",             "filter": "all", "color": "green" },
            { "id": "gcp",   "label": "GCP",           "match": "GCP",                  "filter": "all", "color": "amber" },
            { "id": "kiosk", "label": "Kiosk / PFH Services", "match": "^PFH2? Services", "filter": "all", "color": "rose" },
            { "id": "other", "label": "Other",         "match": ".",                    "filter": "all", "color": "grey" }
          ] }
      ]
    }
  }
}
